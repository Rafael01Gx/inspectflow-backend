# Configurações da Aplicação
SPRING_PROFILE_ACTIVE=prod
SERVER_PORT=3000

# Banco de Dados PostgreSQL
DB_HOST=inspectflow-postgres
DB_PORT=5432
DB_NAME=inspectflow
DB_USER=postgres
DB_PASSWORD=postgres

# Banco de Dados MongoDB
MONGO_URI=mongodb://admin:admin_pass@inspectflow-mongodb:27017/inspectflow?authSource=admin

# Redis (Cache)
REDIS_HOST=inspectflow-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Segurança (JWT)
JWT_EXPIRATION=86400000
JWT_COOKIE_NAME=auth-token
COOKIE_SECURE=true
JWT_COOKIE_HTTP_ONLY=true

# MinIO (Storage)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET_NAME=inspectflow

# Configurações de E-mail (SMTP)
EMAIL_USERNAME=xxxx.jsm@xxxx.com
EMAIL_PASSWORD=xxxxxxxxxxxxx

# Observabilidade
OTEL_EXPORTER_OTLP_ENDPOINT=http://inspectflow-jaeger:4318
TRACING_SAMPLING_PROBABILITY=0.1
ENVIRONMENT=prod
BUILD_VERSION=1.0.0

# Logging
LOGGING_FILE_PATH=/app/logs